# Keep source files UTF-8 and stop editors from re-encoding them.
# The emoji corruption (🏠 -> "ðŸ ") happened because a save round-tripped
# UTF-8 bytes through Windows-1252. These rules make git treat the files as
# text with normalised line endings, which keeps diffs honest and makes a
# repeat of that corruption obvious in review instead of invisible.
* text=auto eol=lf

*.html  text working-tree-encoding=UTF-8
*.css   text working-tree-encoding=UTF-8
*.js    text working-tree-encoding=UTF-8
*.json  text working-tree-encoding=UTF-8
*.sql   text working-tree-encoding=UTF-8
*.md    text working-tree-encoding=UTF-8

*.png   binary
*.jpg   binary
*.pdf   binary
*.zip   binary
